# Copy into Vercel → Project → Settings → Environment Variables (or .env.local for `vercel dev`)
RESEND_API_KEY=
CONTACT_TO=
# Optional: needs a domain verified in Resend. Without it, Resend's test sender only delivers to your Resend account email.
CONTACT_FROM=
# Optional: phone push per signup (no contact details are sent through it)
NTFY_TOPIC=
